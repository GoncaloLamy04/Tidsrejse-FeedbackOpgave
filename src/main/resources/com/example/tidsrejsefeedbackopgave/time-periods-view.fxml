<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="553.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.tidsrejsefeedbackopgave.controller.TimePeriodController">

    <children>
        <Label text="Tidsperioder">
            <font><Font name="System Bold" size="18.0" /></font>
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
        </Label>

        <GridPane hgap="10.0" vgap="20.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" prefWidth="125.0" />
                <ColumnConstraints hgrow="SOMETIMES" prefWidth="435.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="90.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <Label text="Navn:" />
                <Label text="Beskrivelse:" GridPane.rowIndex="1" />

                <TextField fx:id="namePeriod" promptText="Indtast navn"
                           GridPane.columnIndex="1" />

                <!-- TextArea giver mening til beskrivelse -->
                <TextArea fx:id="descriptionField" promptText="Indtast beskrivelse"
                          prefRowCount="3"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Button mnemonicParsing="false" onAction="#createPeriod" text="Opret" />
                        <Button mnemonicParsing="false" onAction="#updatePeriod" text="Opdater" />
                        <Button mnemonicParsing="false" onAction="#removePeriod" text="Slet" />
                        <Button mnemonicParsing="false" onAction="#clearPeriod" text="Ryd" />
                    </children>
                </HBox>
            </children>
        </GridPane>

        <TableView fx:id="timePeriodsTable" prefHeight="377.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="idPeriod" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="periodName" prefWidth="200.0" text="Navn" />
                <TableColumn fx:id="periodColumn" prefWidth="324.0" text="Beskrivelse" />
            </columns>
        </TableView>
    </children>
</VBox>
